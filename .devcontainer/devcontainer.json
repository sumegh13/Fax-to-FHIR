{
  "name": "Fax to FHIR",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  // HAPI FHIR takes ~3 GB of heap; Synthea and the fax renderer like more cores.
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "forwardPorts": [8000, 8080],
  "portsAttributes": {
    "8000": { "label": "Fax intake (review screen)", "onAutoForward": "openBrowser" },
    "8080": { "label": "HAPI FHIR server", "onAutoForward": "silent" }
  },
  // First boot: install, generate patients and faxes, load HAPI (about 15 minutes).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  // Every boot: start HAPI and the review screen.
  "postStartCommand": "bash .devcontainer/start.sh",
  "secrets": {
    "ANTHROPIC_API_KEY": {
      "description": "Claude API key. Without it the app runs the simulated extractor.",
      "documentationUrl": "https://platform.claude.com"
    }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
