# Copy to .env and fill in. .env is git-ignored.

# Claude API key (https://platform.claude.com). When set, the app reads faxes with Claude Haiku 5.5.
ANTHROPIC_API_KEY=

# "claude" or "simulated". Defaults to claude when ANTHROPIC_API_KEY is set.
# EXTRACTOR=

# Fields below this confidence go to the review screen.
REVIEW_THRESHOLD=0.8

# HAPI FHIR server.
FHIR_BASE=http://localhost:8080/fhir

# Cap on model calls per rolling hour, so a shared demo link can't run up the API bill.
MAX_FAXES_PER_HOUR=60
